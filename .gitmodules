[submodule "dependencies/metalrt"]
	path = dependencies/metalrt
	url = git@github.com:bbalfou/metalrt.git
[submodule "dependencies/fmt"]
	path = dependencies/fmt
	url = https://github.com/fmtlib/fmt.git
[submodule "dependencies/pybind11"]
	path = dependencies/pybind11
	url = https://github.com/pybind/pybind11.git
[submodule "dependencies/pybind11_json"]
	path = dependencies/pybind11_json
	url = https://github.com/pybind/pybind11_json.git
